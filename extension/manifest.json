{
  "manifest_version": 3,
  "name": "IDM Clone",
  "version": "1.0.0",
  "description": "Send browser downloads to the IDM Clone app.",
  "permissions": ["alarms", "downloads", "contextMenus", "cookies", "storage", "notifications"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IDM Clone",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "incognito": "spanning"
}
